+type davAccess struct {
+	name        string
+	write, tree bool
+}
+
+func containsDAVPath(parent, child string) bool {
+	return parent == child || parent == "/" || strings.HasPrefix(child, parent+"/")
+}
+
+// acquireRequest owns all source/destination paths as a single operation before
+// any precondition check or file open. Readers coexist; conflicts fail immediately.
+// This is request lifetime protection for one cache-off WebDAV server, not a
+// persistent WebDAV lock or a guarantee against native VFS/external writers.
+func (w *WebDAV) acquireRequest(r *http.Request) (func(), int) {
+	source := path.Clean("/" + strings.TrimPrefix(r.URL.Path, "/"))
+	var claims []davAccess
+	switch r.Method {
+	case "GET", "HEAD", "PROPFIND":
+		claims = []davAccess{{name: source, tree: r.URL.Query().Get("download") == "zip"}}
+	case "PUT", "DELETE", "MKCOL", "PROPPATCH", "LOCK", "UNLOCK":
+		claims = []davAccess{{name: source, write: true, tree: true}}
+	case "MOVE", "COPY":
+		dest, err := url.Parse(r.Header.Get("Destination"))
+		if err != nil || dest.Path == "" || dest.RawQuery != "" || dest.Fragment != "" || (dest.Host != "" && dest.Host != r.Host) {
+			return nil, http.StatusBadRequest
+		}
+		claims = []davAccess{{name: source, write: r.Method == "MOVE", tree: true}, {name: path.Clean("/" + strings.TrimPrefix(dest.Path, "/")), write: true, tree: true}}
+	default:
+		return func() {}, 0
+	}
+	w.accessMu.Lock()
+	defer w.accessMu.Unlock()
+	for _, active := range w.requests {
+		for _, a := range active {
+			for _, b := range claims {
+				overlap := a.name == b.name || (a.tree && containsDAVPath(a.name, b.name)) || (b.tree && containsDAVPath(b.name, a.name))
+				if overlap && (a.write || b.write) {
+					return nil, http.StatusLocked
+				}
+			}
+		}
+	}
+	if w.requests == nil {
+		w.requests = make(map[*http.Request][]davAccess)
+	}
+	w.requests[r] = claims
+	var once sync.Once
+	return func() { once.Do(func() { w.accessMu.Lock(); defer w.accessMu.Unlock(); delete(w.requests, r) }) }, 0
+}
