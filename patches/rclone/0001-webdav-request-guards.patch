+		w.ServeHTTP(rec, httptest.NewRequest("PUT", "http://fixture/file", strings.NewReader("complete data")))
+		return rec.Code
+	}
+	require.Equal(t, 201, put())
+	out := &heldResponse{ResponseRecorder: httptest.NewRecorder(), entered: make(chan struct{}), release: make(chan struct{})}
+	var once sync.Once
+	release := func() { once.Do(func() { close(out.release) }) }
+	defer release()
+	done := make(chan struct{})
+	go func() { defer close(done); w.ServeHTTP(out, httptest.NewRequest("GET", "http://fixture/file", nil)) }()
+	select {
+	case <-out.entered:
+	case <-time.After(5 * time.Second):
+		t.Fatal("read did not start")
+	}
+	second := httptest.NewRecorder()
+	w.ServeHTTP(second, httptest.NewRequest("GET", "http://fixture/file", nil))
+	require.Equal(t, 200, second.Code)
+	require.Equal(t, 423, put())
+	release()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("read did not finish")
+	}
+	require.Equal(t, "complete data", out.Body.String())
+	require.Equal(t, 201, put())
+	missing := httptest.NewRecorder()
+	w.ServeHTTP(missing, httptest.NewRequest("GET", "http://fixture/missing", nil))
+	require.Equal(t, 404, missing.Code)
+	rec := httptest.NewRecorder()
+	w.ServeHTTP(rec, httptest.NewRequest("PUT", "http://fixture/missing", strings.NewReader("now exists")))
+	require.Equal(t, 201, rec.Code)
+}
