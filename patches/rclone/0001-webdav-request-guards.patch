diff --git a/cmd/serve/webdav/webdav.go b/cmd/serve/webdav/webdav.go
index d3420bb..3cc27d4 100644
--- a/cmd/serve/webdav/webdav.go
+++ b/cmd/serve/webdav/webdav.go
@@ -403,6 +403,18 @@ func (w *WebDAV) ServeHTTP(rw http.ResponseWriter, r *http.Request) {
 		w.serveDir(rw, r, remote)
 		return
 	}
+	// Reject create-only PUT before opening a truncating write handle.
+	// This checks the VFS view; backend publication still needs its own
+	// atomic conflict policy against changes made by other clients.
+	if r.Method == "PUT" && strings.TrimSpace(r.Header.Get("If-None-Match")) == "*" {
+		if _, err := w.Stat(r.Context(), remote); err == nil {
+			http.Error(rw, "Precondition Failed", http.StatusPreconditionFailed)
+			return
+		} else if !os.IsNotExist(err) {
+			http.Error(rw, "Failed to check precondition", http.StatusInternalServerError)
+			return
+		}
+	}
 	// Work around bug in x/net/webdav which handles Overwrite incorrectly
 	// See: https://github.com/golang/go/issues/66059
 	// Remove when the above bug is fixed.
@@ -521,6 +533,13 @@ func (w *WebDAV) Mkdir(ctx context.Context, name string, perm os.FileMode) (err
 	if err != nil {
 		return err
 	}
+	// webdav.FileSystem follows os.Mkdir semantics, while VFS Mkdir is
+	// idempotent. RFC 4918 requires MKCOL on an existing resource to fail.
+	if _, err := VFS.Stat(name); err == nil {
+		return os.ErrExist
+	} else if !os.IsNotExist(err) {
+		return err
+	}
 	dir, leaf, err := VFS.StatParent(name)
 	if err != nil {
 		return err
