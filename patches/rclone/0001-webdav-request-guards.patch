+// putBody tracks source completion separately from the VFS upload stream.
+// x/net/webdav closes destinations even after PUT or COPY input failed.
+type putBody struct {
+	io.ReadCloser
+	expected, received int64
+	complete           bool
+	err                error
+}
+
+func (b *putBody) Read(p []byte) (int, error) {
+	n, err := b.ReadCloser.Read(p)
+	b.received += int64(n)
+	if b.expected >= 0 && b.received > b.expected {
+		err = errors.New("upload input exceeds declared size")
+	}
+	if err == io.EOF {
+		if b.expected >= 0 && b.received != b.expected {
+			err = io.ErrUnexpectedEOF
+		} else {
+			b.complete = true
+		}
+	}
+	if err != nil && err != io.EOF {
+		b.err = err
+	}
+	return n, err
+}
