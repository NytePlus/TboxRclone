diff --git a/cmd/serve/webdav/webdav.go b/cmd/serve/webdav/webdav.go
index d3420bb..8c49a71 100644
--- a/cmd/serve/webdav/webdav.go
+++ b/cmd/serve/webdav/webdav.go
@@ -403,6 +403,46 @@ func (w *WebDAV) ServeHTTP(rw http.ResponseWriter, r *http.Request) {
 		w.serveDir(rw, r, remote)
 		return
 	}
+	// Check PUT entity-tag conditions before opening a truncating handle.
+	// This is the VFS view, not an atomic backend publication condition.
+	if r.Method == "PUT" {
+		match := strings.Join(r.Header.Values("If-Match"), ",")
+		none := strings.Join(r.Header.Values("If-None-Match"), ",")
+		if match != "" || none != "" {
+			fi, err := w.Stat(r.Context(), remote)
+			exists := err == nil
+			if err != nil && !os.IsNotExist(err) {
+				http.Error(rw, "Failed to check precondition", http.StatusInternalServerError)
+				return
+			}
+			tag := ""
+			if exists {
+				tag, err = fi.(FileInfo).ETag(r.Context())
+				if err == webdav.ErrNotImplemented {
+					// Same fallback used by x/net/webdav's findETag.
+					tag, err = fmt.Sprintf(`"%x%x"`, fi.ModTime().UnixNano(), fi.Size()), nil
+				}
+				if err != nil {
+					http.Error(rw, "Failed to check ETag", http.StatusInternalServerError)
+					return
+				}
+			}
+			if match != "" {
+				matches, valid := matchEntityTags(match, tag, exists, false)
+				if !valid || !matches {
+					http.Error(rw, "Precondition Failed", http.StatusPreconditionFailed)
+					return
+				}
+			}
+			if none != "" {
+				matches, valid := matchEntityTags(none, tag, exists, true)
+				if !valid || matches {
+					http.Error(rw, "Precondition Failed", http.StatusPreconditionFailed)
+					return
+				}
+			}
+		}
+	}
 	// Work around bug in x/net/webdav which handles Overwrite incorrectly
 	// See: https://github.com/golang/go/issues/66059
 	// Remove when the above bug is fixed.
@@ -521,6 +561,13 @@ func (w *WebDAV) Mkdir(ctx context.Context, name string, perm os.FileMode) (err
 	if err != nil {
 		return err
 	}
+	// webdav.FileSystem follows os.Mkdir semantics, while VFS Mkdir is
+	// idempotent. RFC 4918 requires MKCOL on an existing resource to fail.
+	if _, err := VFS.Stat(name); err == nil {
+		return os.ErrExist
+	} else if !os.IsNotExist(err) {
+		return err
+	}
 	dir, leaf, err := VFS.StatParent(name)
 	if err != nil {
 		return err
@@ -723,3 +770,53 @@ func (fi FileInfo) ContentType(ctx context.Context) (contentType string, err err
 	fs.Errorf(fi, "Expecting fs.Object or fs.Directory, got %T", entry)
 	return "application/octet-stream", nil
 }
+
+// matchEntityTags parses the complete HTTP entity-tag list, including quoted
+// commas. If-Match requires strong comparison; If-None-Match uses weak comparison.
+func matchEntityTags(value, current string, exists, weak bool) (bool, bool) {
+	value = strings.TrimSpace(value)
+	if value == "*" {
+		return exists, true
+	}
+	matched := false
+	for value != "" {
+		original := value
+		isWeak := strings.HasPrefix(value, "W/")
+		if isWeak {
+			value = value[2:]
+		}
+		if len(value) == 0 || value[0] != '"' {
+			return false, false
+		}
+		end := 1
+		for end < len(value) && value[end] != '"' {
+			if value[end] < 0x21 || value[end] == 0x7f {
+				return false, false
+			}
+			end++
+		}
+		if end == len(value) {
+			return false, false
+		}
+		tag := value[:end+1]
+		if exists && ((weak && tag == strings.TrimPrefix(current, "W/")) || (!weak && !isWeak && tag == current)) {
+			matched = true
+		}
+		consumed := end + 1
+		if isWeak {
+			consumed += 2
+		}
+		value = strings.TrimSpace(original[consumed:])
+		if value == "" {
+			return matched, true
+		}
+		if value[0] != ',' {
+			return false, false
+		}
+		value = strings.TrimSpace(value[1:])
+		if value == "" {
+			return false, false
+		}
+	}
+	return false, false
+}
diff --git a/cmd/serve/webdav/webdav_test.go b/cmd/serve/webdav/webdav_test.go
index bd14826..43e5611 100644
--- a/cmd/serve/webdav/webdav_test.go
+++ b/cmd/serve/webdav/webdav_test.go
@@ -438,3 +438,89 @@ func TestMoveOverwriteFalseStillRejects(t *testing.T) {
 	assert.Equal(t, http.StatusPreconditionFailed, resp.StatusCode,
 		"MOVE with explicit Overwrite: F must still return 412 when destination exists")
 }
+
+func TestMkcolExistingResourceRejected(t *testing.T) {
+	base := startWritableServer(t)
+	mkcol(t, base, "exists")
+	for _, path := range []string{"exists", "exists/"} {
+		req, err := http.NewRequest("MKCOL", base+path, nil)
+		require.NoError(t, err)
+		resp, err := http.DefaultClient.Do(req)
+		require.NoError(t, err)
+		_ = resp.Body.Close()
+		require.Equal(t, http.StatusMethodNotAllowed, resp.StatusCode)
+	}
+}
+
+func TestPutIfNoneMatchStarPreservesExistingFile(t *testing.T) {
+	base := startWritableServer(t)
+	for i, payload := range []string{"original", "replacement"} {
+		req, err := http.NewRequest("PUT", base+"conditional.txt", strings.NewReader(payload))
+		require.NoError(t, err)
+		req.Header.Set("If-None-Match", "*")
+		resp, err := http.DefaultClient.Do(req)
+		require.NoError(t, err)
+		_ = resp.Body.Close()
+		expected := http.StatusCreated
+		if i == 1 {
+			expected = http.StatusPreconditionFailed
+		}
+		require.Equal(t, expected, resp.StatusCode)
+	}
+	resp, err := http.Get(base + "conditional.txt")
+	require.NoError(t, err)
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	require.NoError(t, err)
+	require.Equal(t, "original", string(body))
+}
+
+func TestPutEntityTagConditions(t *testing.T) {
+	for _, tc := range []struct {
+		name, header, value string
+		allow               bool
+	}{
+		{"wrong_match", "If-Match", `"wrong"`, false},
+		{"matching", "If-Match", "CURRENT", true},
+		{"weak_match", "If-Match", "W/CURRENT", false},
+		{"match_list", "If-Match", `"other", CURRENT`, true},
+		{"none_match", "If-None-Match", "CURRENT", false},
+		{"weak_none_match", "If-None-Match", "W/CURRENT", false},
+		{"none_other", "If-None-Match", `"other"`, true},
+		{"invalid_list", "If-Match", `CURRENT,invalid`, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			base := startWritableServer(t)
+			req, err := http.NewRequest("PUT", base+"file", strings.NewReader("original"))
+			require.NoError(t, err)
+			resp, err := http.DefaultClient.Do(req)
+			require.NoError(t, err)
+			resp.Body.Close()
+			require.Equal(t, 201, resp.StatusCode)
+			resp, err = http.Get(base + "file")
+			require.NoError(t, err)
+			etag := resp.Header.Get("ETag")
+			require.NotEmpty(t, etag)
+			resp.Body.Close()
+			req, err = http.NewRequest("PUT", base+"file", strings.NewReader("replacement"))
+			require.NoError(t, err)
+			req.Header.Set(tc.header, strings.ReplaceAll(tc.value, "CURRENT", etag))
+			resp, err = http.DefaultClient.Do(req)
+			require.NoError(t, err)
+			resp.Body.Close()
+			want := http.StatusPreconditionFailed
+			contents := "original"
+			if tc.allow {
+				want = http.StatusCreated
+				contents = "replacement"
+			}
+			require.Equal(t, want, resp.StatusCode)
+			resp, err = http.Get(base + "file")
+			require.NoError(t, err)
+			defer resp.Body.Close()
+			b, err := io.ReadAll(resp.Body)
+			require.NoError(t, err)
+			require.Equal(t, contents, string(b))
+		})
+	}
+}
