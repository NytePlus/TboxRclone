@@ -438,3 +438,39 @@ func TestMoveOverwriteFalseStillRejects(t *testing.T) {
 	assert.Equal(t, http.StatusPreconditionFailed, resp.StatusCode,
 		"MOVE with explicit Overwrite: F must still return 412 when destination exists")
 }
+
+func TestMkcolExistingResourceRejected(t *testing.T) {
+	base := startWritableServer(t)
+	mkcol(t, base, "exists")
+	for _, path := range []string{"exists", "exists/"} {
+		req, err := http.NewRequest("MKCOL", base+path, nil)
+		require.NoError(t, err)
+		resp, err := http.DefaultClient.Do(req)
+		require.NoError(t, err)
+		_ = resp.Body.Close()
+		require.Equal(t, http.StatusMethodNotAllowed, resp.StatusCode)
+	}
+}
+
+func TestPutIfNoneMatchStarPreservesExistingFile(t *testing.T) {
+	base := startWritableServer(t)
+	for i, payload := range []string{"original", "replacement"} {
+		req, err := http.NewRequest("PUT", base+"conditional.txt", strings.NewReader(payload))
+		require.NoError(t, err)
+		req.Header.Set("If-None-Match", "*")
+		resp, err := http.DefaultClient.Do(req)
+		require.NoError(t, err)
+		_ = resp.Body.Close()
+		expected := http.StatusCreated
+		if i == 1 {
+			expected = http.StatusPreconditionFailed
+		}
+		require.Equal(t, expected, resp.StatusCode)
+	}
+	resp, err := http.Get(base + "conditional.txt")
+	require.NoError(t, err)
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	require.NoError(t, err)
+	require.Equal(t, "original", string(body))
+}
