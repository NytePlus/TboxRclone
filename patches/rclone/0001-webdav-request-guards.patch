+// COPY must let the backend replace a file, without removing the old target
+// before an upload that can be rejected.
+func TestExclusiveCopyPreservesTargetUntilPut(t *testing.T) {
+	for _, reject := range []bool{false, true} {
+		t.Run(fmt.Sprint(reject), func(t *testing.T) {
+			root := t.TempDir()
+			require.NoError(t, os.WriteFile(root+"/source", []byte("replacement"), 0600))
+			require.NoError(t, os.WriteFile(root+"/target", []byte("original"), 0600))
+			f, err := fs.NewFs(context.Background(), root)
+			require.NoError(t, err)
+			wrapped := &copyCheckingFs{Fs: f, root: root, reject: reject}
+			opt := Opt
+			opt.ExclusiveAccess = true
+			opt.HTTP.ListenAddr = []string{testBindAddress}
+			w, err := newWebDAV(context.Background(), wrapped, &opt, &vfscommon.Opt, &proxy.Opt)
+			require.NoError(t, err)
+			defer w.Shutdown()
+			request := func(overwrite string) *httptest.ResponseRecorder {
+				r := httptest.NewRequest("COPY", "http://fixture/source", nil)
+				r.Header.Set("Destination", "http://fixture/target")
+				if overwrite != "" {
+					r.Header.Set("Overwrite", overwrite)
+				}
+				out := httptest.NewRecorder()
+				w.ServeHTTP(out, r)
+				return out
+			}
+			require.Equal(t, 412, request("F").Code)
+			require.Zero(t, wrapped.calls)
+			out := request("")
+			require.Positive(t, wrapped.calls)
+			require.False(t, wrapped.targetMissing, "target was deleted before backend upload")
+			b, err := os.ReadFile(root + "/target")
+			require.NoError(t, err)
+			if reject {
+				require.GreaterOrEqual(t, out.Code, 400)
+				require.Equal(t, "original", string(b))
+			} else {
+				require.Equal(t, 204, out.Code)
+				require.Equal(t, "replacement", string(b))
+			}
+			b, err = os.ReadFile(root + "/source")
+			require.NoError(t, err)
+			require.Equal(t, "replacement", string(b))
+		})
+	}
+}
+
+type copyCheckingFs struct {
+	fs.Fs
+	root          string
+	reject        bool
+	calls         int
+	targetMissing bool
+}
+
+func (f *copyCheckingFs) Put(ctx context.Context, in io.Reader, src fs.ObjectInfo, opts ...fs.OpenOption) (fs.Object, error) {
+	f.calls++
+	b, err := os.ReadFile(f.root + "/target")
+	if err != nil || string(b) != "original" {
+		f.targetMissing = true
+	}
+	if f.reject {
+		return nil, errors.New("injected upload rejection")
+	}
+	return f.Fs.Put(ctx, in, src, opts...)
+}
