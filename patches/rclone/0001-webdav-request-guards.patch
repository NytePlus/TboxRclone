+func TestExclusiveCopyDirectoryBoundaries(t *testing.T) {
+	for _, kind := range []string{"new-tree", "file-to-dir", "dir-to-file", "dir-to-dir"} {
+		t.Run(kind, func(t *testing.T) {
+			root := t.TempDir()
+			require.NoError(t, os.MkdirAll(root+"/tree/nested", 0700))
+			require.NoError(t, os.MkdirAll(root+"/target-dir", 0700))
+			for name, content := range map[string]string{"tree/nested/file": "content", "tree/empty": "", "file": "source", "target-file": "old-file", "target-dir/child": "old-child"} {
+				require.NoError(t, os.WriteFile(root+"/"+name, []byte(content), 0600))
+			}
+			f, err := fs.NewFs(context.Background(), root)
+			require.NoError(t, err)
+			opt := Opt
+			opt.ExclusiveAccess = true
+			opt.HTTP.ListenAddr = []string{testBindAddress}
+			w, err := newWebDAV(context.Background(), f, &opt, &vfscommon.Opt, &proxy.Opt)
+			require.NoError(t, err)
+			defer w.Shutdown()
+			source, target := "tree", "new-tree"
+			switch kind {
+			case "file-to-dir":
+				source, target = "file", "target-dir"
+			case "dir-to-file":
+				target = "target-file"
+			case "dir-to-dir":
+				target = "target-dir"
+			}
+			req := httptest.NewRequest("COPY", "http://fixture/"+source, nil)
+			req.Header.Set("Destination", "http://fixture/"+target)
+			req.Header.Set("Overwrite", "T")
+			out := httptest.NewRecorder()
+			w.ServeHTTP(out, req)
+			if kind == "new-tree" {
+				require.Equal(t, 201, out.Code)
+				for name, want := range map[string]string{"new-tree/nested/file": "content", "new-tree/empty": ""} {
+					b, e := os.ReadFile(root + "/" + name)
+					require.NoError(t, e)
+					require.Equal(t, want, string(b))
+				}
+			} else {
+				require.Equal(t, 403, out.Code)
+			}
+			for name, want := range map[string]string{"tree/nested/file": "content", "tree/empty": "", "file": "source", "target-file": "old-file", "target-dir/child": "old-child"} {
+				b, e := os.ReadFile(root + "/" + name)
+				require.NoError(t, e)
+				require.Equal(t, want, string(b))
+			}
+		})
+	}
