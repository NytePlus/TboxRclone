+// matchEntityTags parses the complete HTTP entity-tag list, including quoted
+// commas. If-Match requires strong comparison; If-None-Match uses weak comparison.
+func matchEntityTags(value, current string, exists, weak bool) (bool, bool) {
+	value = strings.TrimSpace(value)
+	if value == "*" {
+		return exists, true
+	}
+	matched := false
+	for value != "" {
+		original := value
+		isWeak := strings.HasPrefix(value, "W/")
+		if isWeak {
+			value = value[2:]
+		}
+		if len(value) == 0 || value[0] != '"' {
+			return false, false
+		}
+		end := 1
+		for end < len(value) && value[end] != '"' {
+			if value[end] < 0x21 || value[end] == 0x7f {
+				return false, false
+			}
+			end++
+		}
+		if end == len(value) {
+			return false, false
+		}
+		tag := value[:end+1]
+		if exists && ((weak && tag == strings.TrimPrefix(current, "W/")) || (!weak && !isWeak && tag == current)) {
+			matched = true
+		}
+		consumed := end + 1
+		if isWeak {
+			consumed += 2
+		}
+		value = strings.TrimSpace(original[consumed:])
+		if value == "" {
+			return matched, true
+		}
+		if value[0] != ',' {
+			return false, false
+		}
+		value = strings.TrimSpace(value[1:])
+		if value == "" {
+			return false, false
+		}
+	}
+	return false, false
+}
