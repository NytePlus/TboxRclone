+func TestMoveBackendOverwriteKeepsTargetUntilRename(t *testing.T) {
+	for _, reject := range []bool{false, true} {
+		name := "success"
+		if reject {
+			name = "reject"
+		}
+		t.Run(name, func(t *testing.T) {
+			root := t.TempDir()
+			require.NoError(t, os.WriteFile(root+"/source", []byte("new"), 0600))
+			require.NoError(t, os.WriteFile(root+"/target", []byte("old"), 0600))
+			f, err := fs.NewFs(context.Background(), root)
+			require.NoError(t, err)
+			move := f.Features().Move
+			f.Features().MoveOverwrites = true
+			calls := 0
+			f.Features().Move = func(ctx context.Context, src fs.Object, remote string) (fs.Object, error) {
+				calls++
+				b, err := os.ReadFile(root + "/target")
+				if err != nil || string(b) != "old" {
+					return nil, errors.New("target deleted before backend move")
+				}
+				if reject {
+					return nil, errors.New("move rejected")
+				}
