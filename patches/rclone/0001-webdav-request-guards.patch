+func TestMoveBackendOverwriteKeepsTargetUntilRename(t *testing.T) {
+	for _, reject := range []bool{false, true} {
+		name := "success"
+		if reject {
+			name = "reject"
+		}
+		t.Run(name, func(t *testing.T) {
+			root := t.TempDir()
+			require.NoError(t, os.WriteFile(root+"/source", []byte("new"), 0600))
+			require.NoError(t, os.WriteFile(root+"/target", []byte("old"), 0600))
+			f, err := fs.NewFs(context.Background(), root)
+			require.NoError(t, err)
+			move := f.Features().Move
+			f.Features().MoveOverwrites = true
+			calls := 0
+			f.Features().Move = func(ctx context.Context, src fs.Object, remote string) (fs.Object, error) {
+				calls++
+				b, err := os.ReadFile(root + "/target")
+				if err != nil || string(b) != "old" {
+					return nil, errors.New("target deleted before backend move")
+				}
+				if reject {
+					return nil, errors.New("move rejected")
+				}
+				return move(ctx, src, remote)
+			}
+			opt := Opt
+			opt.ExclusiveAccess = true
+			opt.HTTP.ListenAddr = []string{testBindAddress}
+			w, err := newWebDAV(context.Background(), f, &opt, &vfscommon.Opt, &proxy.Opt)
+			require.NoError(t, err)
+			defer w.Shutdown()
+			req := httptest.NewRequest("MOVE", "http://fixture/source", nil)
+			req.Header.Set("Destination", "http://fixture/target")
+			req.Header.Set("Overwrite", "F")
+			out := httptest.NewRecorder()
+			w.ServeHTTP(out, req)
+			require.Equal(t, 412, out.Code)
+			require.Zero(t, calls)
+			req = httptest.NewRequest("MOVE", "http://fixture/source", nil)
+			req.Header.Set("Destination", "http://fixture/target")
+			out = httptest.NewRecorder()
+			w.ServeHTTP(out, req)
+			require.Equal(t, 1, calls)
+			b, err := os.ReadFile(root + "/target")
+			require.NoError(t, err)
+			if reject {
+				require.Equal(t, 403, out.Code)
+				require.Equal(t, "old", string(b))
+				b, err = os.ReadFile(root + "/source")
+				require.NoError(t, err)
+				require.Equal(t, "new", string(b))
+			} else {
+				require.Equal(t, 204, out.Code)
+				require.Equal(t, "new", string(b))
+				_, err = os.Stat(root + "/source")
+				require.True(t, os.IsNotExist(err))
+			}
+		})
+	}
+}
