+func TestMoveBackendOverwritePreservesDestinationOnFailure(t *testing.T) {
+	for _, supported := range []bool{false, true} {
+		t.Run(fmt.Sprint(supported), func(t *testing.T) {
+			ctx := context.Background()
+			root := t.TempDir()
+			require.NoError(t, os.WriteFile(root+"/source", []byte("new"), 0600))
+			require.NoError(t, os.WriteFile(root+"/target", []byte("old"), 0600))
+			f, err := fs.NewFs(ctx, root)
+			require.NoError(t, err)
+			src, err := f.NewObject(ctx, "source")
+			require.NoError(t, err)
+			dst, err := f.NewObject(ctx, "target")
+			require.NoError(t, err)
+			f.Features().MoveOverwrites = supported
+			failed := errors.New("move rejected before mutation")
+			calls := 0
+			f.Features().Move = func(context.Context, fs.Object, string) (fs.Object, error) {
+				calls++
+				return nil, failed
+			}
+			_, err = operations.Move(ctx, f, dst, "target", src)
+			require.ErrorIs(t, err, failed)
+			require.Equal(t, 1, calls)
+			content, err := os.ReadFile(root + "/target")
+			if supported {
+				require.NoError(t, err)
+				require.Equal(t, "old", string(content))
+			} else {
+				require.True(t, os.IsNotExist(err), "legacy pre-delete behavior changed: %v", err)
+			}
+			content, err = os.ReadFile(root + "/source")
+			require.NoError(t, err)
+			require.Equal(t, "new", string(content))
+		})
+	}
+}
+
+func TestNativeDirectoryMoveErrorDoesNotFallBack(t *testing.T) {
+	ctx := context.Background()
+	root := t.TempDir()
+	require.NoError(t, os.Mkdir(root+"/source", 0700))
+	require.NoError(t, os.Mkdir(root+"/target", 0700))
+	require.NoError(t, os.WriteFile(root+"/source/child", []byte("source"), 0600))
+	require.NoError(t, os.WriteFile(root+"/target/keep", []byte("keep"), 0600))
+	f, err := fs.NewFs(ctx, root)
+	require.NoError(t, err)
+	f.Features().NoDirMoveFallback = true
+	f.Features().DirMove = func(context.Context, fs.Fs, string, string) error { return fs.ErrorDirExists }
+	err = operations.DirMove(ctx, f, "source", "target")
+	require.ErrorIs(t, err, fs.ErrorDirExists)
+	b, err := os.ReadFile(root + "/source/child")
+	require.NoError(t, err)
+	require.Equal(t, "source", string(b))
+	_, err = os.Stat(root + "/target/child")
+	require.True(t, os.IsNotExist(err))
+	b, err = os.ReadFile(root + "/target/keep")
+	require.NoError(t, err)
+	require.Equal(t, "keep", string(b))
+}
