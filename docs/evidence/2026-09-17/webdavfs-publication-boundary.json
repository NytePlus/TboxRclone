  "macos": "26.5.2 (25F84)",
  "server": "golang.org/x/net/webdav v0.57.0, local Dir + NewMemLS",
  "source_commit": "a239d37d7407700119e9c92f66f38ab0a296cb0f",
  "source_url": "https://github.com/apple-oss-distributions/webdavfs/tree/a239d37d7407700119e9c92f66f38ab0a296cb0f",
  "cases": [
    "empty",
    "single_write_fsync",
    "two_writes_two_fsync",
    "empty_open_held_one_second",
    "nonempty_open_and_fsync_held_one_second"
  ],
  "observations": [
    "Initial empty PUT precedes the first LOCK for new files.",
    "New files have a LOCK/UNLOCK pair before the application open call returns, then another LOCK/UNLOCK lifetime.",
    "UNLOCK alone cannot identify completion of the user copy: the first UNLOCK precedes application data.",
    "Two fsync calls produce two content PUT requests under the later lock.",
    "X-Expected-Entity-Length was absent for these small writes; it is not a reliable final-content marker."
  ],
  "verdict": "Do not implement publish-on-first-UNLOCK or time-based placeholder completion. Additional native ownership/commit signaling requires investigation.",
