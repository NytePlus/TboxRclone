--- /dev/null
+++ b/cmd/serve/webdav/propfind_listing.go
@@ -0,0 +1,36 @@
+package webdav
+
+import (
+	"context"
+	"path"
+	"sync"
+
+	"github.com/rclone/rclone/vfs"
+)
+
+type propfindNodesKey struct{}
+
+// x/net/webdav opens each listed child repeatedly to collect properties.
+// Reuse the nodes enumerated by this request, not the global directory cache:
+// a new request must still refresh metadata when DirCacheTime is zero.
+type propfindNodes struct {
+	mu    sync.Mutex
+	nodes map[string]vfs.Node
+}
+
+func propfindNode(ctx context.Context, name string) vfs.Node {
+	if cache, ok := ctx.Value(propfindNodesKey{}).(*propfindNodes); ok {
+		cache.mu.Lock()
+		defer cache.mu.Unlock()
+		return cache.nodes[path.Clean("/"+name)]
+	}
+	return nil
+}
+
+func rememberPropfindNode(ctx context.Context, name string, node vfs.Node) {
+	if cache, ok := ctx.Value(propfindNodesKey{}).(*propfindNodes); ok {
+		cache.mu.Lock()
+		defer cache.mu.Unlock()
+		cache.nodes[path.Clean("/"+name)] = node
+	}
+}
diff --git a/cmd/serve/webdav/propfind_listing_test.go b/cmd/serve/webdav/propfind_listing_test.go
new file mode 100644
index 0000000..9ccb384
--- /dev/null
+++ b/cmd/serve/webdav/propfind_listing_test.go
@@ -0,0 +1,68 @@
+package webdav
+
+import (
+	"context"
+	"fmt"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+
+	"github.com/rclone/rclone/cmd/serve/proxy"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/vfs/vfscommon"
+	"github.com/stretchr/testify/require"
+)
+
+type countedListFs struct {
+	fs.Fs
+	calls atomic.Int64
+}
+
+func (f *countedListFs) List(ctx context.Context, dir string) (fs.DirEntries, error) {
+	f.calls.Add(1)
+	return f.Fs.List(ctx, dir)
+}
+
+func TestPropfindBoundedListingsAndFreshNextRequest(t *testing.T) {
+	for _, directory := range []string{"", "parent/child"} {
+		t.Run(directory, func(t *testing.T) { checkPropfindListings(t, directory) })
+	}
+}
+
+func checkPropfindListings(t *testing.T, directory string) {
+	root := t.TempDir()
+	fixture := filepath.Join(root, directory)
+	require.NoError(t, os.MkdirAll(fixture, 0700))
+	for i := 0; i < 20; i++ {
+		require.NoError(t, os.WriteFile(filepath.Join(fixture, fmt.Sprintf("file-%02d.txt", i)), []byte("fixture"), 0600))
+	}
+	base, err := fs.NewFs(context.Background(), root)
+	require.NoError(t, err)
+	f := &countedListFs{Fs: base}
+	opt := Opt
+	opt.HTTP.ListenAddr = []string{testBindAddress}
+	vopt := vfscommon.Opt
+	vopt.DirCacheTime = 0
+	w, err := newWebDAV(context.Background(), f, &opt, &vopt, &proxy.Opt)
+	require.NoError(t, err)
+	defer w.Shutdown()
+	query := func() string {
+		f.calls.Store(0)
+		req := httptest.NewRequest("PROPFIND", "http://fixture/"+directory, nil)
+		req.Header.Set("Depth", "1")
+		out := httptest.NewRecorder()
+		w.ServeHTTP(out, req)
+		require.Equal(t, 207, out.Code)
+		require.LessOrEqual(t, f.calls.Load(), int64(4), "one directory response must not relist for every child")
+		t.Logf("backend listings: %d", f.calls.Load())
+		return out.Body.String()
+	}
+	body := query()
+	require.Contains(t, body, "file-19.txt")
+	require.NoError(t, os.Rename(filepath.Join(fixture, "file-19.txt"), filepath.Join(fixture, "changed.txt")))
+	body = query()
+	require.Contains(t, body, "changed.txt")
+	require.NotContains(t, body, "file-19.txt")
+}
diff --git a/cmd/serve/webdav/read_stream_test.go b/cmd/serve/webdav/read_stream_test.go
new file mode 100644
index 0000000..51cc89f
--- /dev/null
+++ b/cmd/serve/webdav/read_stream_test.go
@@ -0,0 +1,122 @@
+package webdav
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http/httptest"
+	"os"
+	"sync/atomic"
+	"testing"
+
+	"github.com/rclone/rclone/cmd/serve/proxy"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/vfs/vfscommon"
+	"github.com/stretchr/testify/require"
+)
+
+type unavailableReadFs struct {
+	fs.Fs
+	failed atomic.Bool
+	opens  atomic.Int32
+}
+
+func (f *unavailableReadFs) List(ctx context.Context, path string) (fs.DirEntries, error) {
+	entries, err := f.Fs.List(ctx, path)
+	for i, entry := range entries {
+		if o, ok := entry.(fs.Object); ok {
+			entries[i] = &unavailableReadObject{Object: o, owner: f}
+		}
+	}
+	return entries, err
+}
+func (f *unavailableReadFs) NewObject(ctx context.Context, path string) (fs.Object, error) {
+	o, err := f.Fs.NewObject(ctx, path)
+	if err != nil {
+		return nil, err
+	}
+	return &unavailableReadObject{Object: o, owner: f}, nil
+}
+
+type unavailableReadObject struct {
+	fs.Object
+	owner *unavailableReadFs
+}
+
+func (o *unavailableReadObject) Open(ctx context.Context, opts ...fs.OpenOption) (io.ReadCloser, error) {
+	o.owner.opens.Add(1)
+	if o.owner.failed.Load() {
+		return nil, errors.New("upstream read unavailable")
+	}
+	return o.Object.Open(ctx, opts...)
+}
+
+func TestReadOpenFailureDoesNotSendSuccess(t *testing.T) {
+	for _, span := range []string{"", "bytes=2-7"} {
+		t.Run(span, func(t *testing.T) {
+			root := t.TempDir()
+			require.NoError(t, os.WriteFile(root+"/file.bin", []byte("0123456789abcdef"), 0600))
+			base, err := fs.NewFs(context.Background(), root)
+			require.NoError(t, err)
+			f := &unavailableReadFs{Fs: base}
+			f.failed.Store(true)
+			opt := Opt
+			opt.HTTP.ListenAddr = []string{testBindAddress}
+			vopt := vfscommon.Opt
+			vopt.ReadWait = 0
+			w, err := newWebDAV(context.Background(), f, &opt, &vopt, &proxy.Opt)
+			require.NoError(t, err)
+			defer w.Shutdown()
+			request := func() *httptest.ResponseRecorder {
+				r := httptest.NewRequest("GET", "http://fixture/file.bin", nil)
+				r.Header.Set("Range", span)
+				out := httptest.NewRecorder()
+				w.ServeHTTP(out, r)
+				return out
+			}
+			out := request()
+			require.Positive(t, f.opens.Load())
+			require.GreaterOrEqual(t, out.Code, 500, "unavailable data must not look like a successful empty/truncated representation")
+			require.Empty(t, out.Header().Get("Content-Range"))
+			f.failed.Store(false)
+			out = request()
+			if span == "" {
+				require.Equal(t, 200, out.Code)
+				require.Equal(t, "0123456789abcdef", out.Body.String())
+			} else {
+				require.Equal(t, 206, out.Code)
+				require.Equal(t, "234567", out.Body.String())
+			}
+		})
+	}
+}
+
+func TestDeferredReadHeadersPreserveBodylessResponses(t *testing.T) {
+	root := t.TempDir()
+	require.NoError(t, os.WriteFile(root+"/empty.bin", nil, 0600))
+	require.NoError(t, os.WriteFile(root+"/file.bin", []byte("content"), 0600))
+	base, err := fs.NewFs(context.Background(), root)
+	require.NoError(t, err)
+	f := &unavailableReadFs{Fs: base}
+	f.failed.Store(true)
+	opt := Opt
+	opt.HTTP.ListenAddr = []string{testBindAddress}
+	w, err := newWebDAV(context.Background(), f, &opt, &vfscommon.Opt, &proxy.Opt)
+	require.NoError(t, err)
+	defer w.Shutdown()
+	for _, tc := range []struct {
+		method, path, span string
+		status             int
+	}{
+		{"HEAD", "/file.bin", "", 200},
+		{"GET", "/empty.bin", "", 200},
+		{"GET", "/file.bin", "bytes=99-100", 416},
+	} {
+		r := httptest.NewRequest(tc.method, "http://fixture"+tc.path, nil)
+		r.Header.Set("Range", tc.span)
+		out := httptest.NewRecorder()
+		w.ServeHTTP(out, r)
+		require.Equal(t, tc.status, out.Code)
+	}
+	require.Zero(t, f.opens.Load(), "bodyless responses must not open remote content")
+}
