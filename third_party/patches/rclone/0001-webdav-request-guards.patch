+// x/net/webdav returns 405 for every destination Close error. A backend
+// duplicate is a resource conflict and must remain distinguishable from an
+// unrelated upload failure so Finder can present the collision to the user.
+func TestPutMapsBackendExistsToConflict(t *testing.T) {
