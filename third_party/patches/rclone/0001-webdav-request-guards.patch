new file mode 100644
index 0000000..783eb54
--- /dev/null
+++ b/cmd/serve/webdav/read_error.go
@@ -0,0 +1,53 @@
+package webdav
+
+import (
+	"errors"
+	"net/http"
+	"os"
+
+	"github.com/rclone/rclone/fs"
+)
+
+// x/net/webdav reports every failed GET/HEAD OpenFile as 404. Preserve actual
+// absence, but distinguish access failures and unavailable metadata. This runs
+// before response headers, without buffering successful download bodies.
+func readMetadataStatus(err error) int {
+	if err == nil || os.IsNotExist(err) || errors.Is(err, fs.ErrorObjectNotFound) || errors.Is(err, fs.ErrorDirNotFound) {
+		return http.StatusNotFound
+	}
+	if errors.Is(err, fs.ErrorPermissionDenied) || os.IsPermission(err) {
+		return http.StatusForbidden
+	}
+	var statusError interface{ HTTPStatus() int }
+	if errors.As(err, &statusError) {
+		status := statusError.HTTPStatus()
+		if status == http.StatusUnauthorized {
+			return http.StatusForbidden
+		}
+		if status >= 400 && status <= 599 {
+			return status
+		}
+	}
+	return http.StatusInternalServerError
+}
+
+// finishRead rejects a failed lazy open before committing successful headers.
+// Successful bodies stream directly once the first bytes become available.
+func (rw *webdavRW) finishRead() {
+	if !rw.readPending {
+		return
+	}
+	rw.readPending = false
+	rw.readResult.readMu.Lock()
+	err := rw.readResult.readErr
+	rw.readResult.readMu.Unlock()
+	if err != nil {
+		rw.status = http.StatusBadGateway
+		for _, key := range []string{"Content-Length", "Content-Range", "ETag", "Last-Modified", "Accept-Ranges", "Content-Type"} {
+			rw.Header().Del(key)
+		}
+		http.Error(rw.ResponseWriter, http.StatusText(rw.status), rw.status)
+		return
+	}
+	rw.ResponseWriter.WriteHeader(rw.status)
+}
